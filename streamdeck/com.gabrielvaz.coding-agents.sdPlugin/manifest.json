{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Coding Agents",
  "Version": "0.2.0.0",
  "Author": "Gabriel Vaz",
  "Description": "Live tiles for your Claude Code, Codex, Gemini CLI, Antigravity CLI and herdr sessions. Press a key to open that session's window; hold it to approve.",
  "URL": "https://github.com/gabrielvaz/stream-deck-coding-agents",
  "Icon": "imgs/plugin",
  "Category": "Coding Agents",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/plugin.mjs",
  "UUID": "com.gabrielvaz.coding-agents",
  "SDKVersion": 2,
  "Software": { "MinimumVersion": "6.5" },
  "OS": [
    { "Platform": "mac", "MinimumVersion": "12" },
    { "Platform": "windows", "MinimumVersion": "10" }
  ],
  "Nodejs": { "Version": "20", "Debug": "enabled" },
  "Actions": [
    {
      "Name": "Agent Session",
      "UUID": "com.gabrielvaz.coding-agents.session",
      "Icon": "imgs/session",
      "Tooltip": "Shows one agent session. Press: open its window. Hold: allow a pending approval.",
      "PropertyInspectorPath": "pi/index.html",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/session", "TitleAlignment": "top", "ShowTitle": false }],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false
    },
    {
      "Name": "Agents Hub",
      "UUID": "com.gabrielvaz.coding-agents.hub",
      "Icon": "imgs/hub",
      "Tooltip": "Summary of all sessions. Press: open the first session waiting for you.",
      "PropertyInspectorPath": "pi/index.html",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/hub", "ShowTitle": false }],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false
    },
    {
      "Name": "Allow",
      "UUID": "com.gabrielvaz.coding-agents.allow",
      "Icon": "imgs/allow",
      "Tooltip": "Approve the first pending permission request.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/allow", "ShowTitle": false }],
      "UserTitleEnabled": false
    },
    {
      "Name": "Deny",
      "UUID": "com.gabrielvaz.coding-agents.deny",
      "Icon": "imgs/deny",
      "Tooltip": "Deny the first pending permission request.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/deny", "ShowTitle": false }],
      "UserTitleEnabled": false
    },
    {
      "Name": "Next Page",
      "UUID": "com.gabrielvaz.coding-agents.page",
      "Icon": "imgs/page",
      "Tooltip": "Cycle the session keys through the next page of sessions.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/page", "ShowTitle": false }],
      "UserTitleEnabled": false
    }
  ]
}
