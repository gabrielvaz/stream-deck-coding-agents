# Optional: run the Agent Deck SERVER as a user service on the dev machine (Linux, systemd).
#   mkdir -p ~/.config/systemd/user && cp agent-deck.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now agent-deck
# Edit WorkingDirectory to the checkout path.
[Unit]
Description=Agent Deck server (coding agent status board)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/dev/stream-deck-coding-agents
ExecStart=/usr/bin/env node bin/agent-deck.mjs serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
